# Display width, ported from the Rust unicode-width crate 0.2.2
# (src/tables.rs, MIT OR Apache-2.0). Internal to unicode_text: use `width`
# and `scalar_width` in lib.plenty.
#
# A string is measured from its last scalar to its first. Each step sees the
# state left by the scalars after it, a `WidthInfo` value of unicode-width,
# and returns a width adjustment and the state for the scalar before it. The
# constants keep unicode-width's bit patterns, because the presentation
# selectors and ZWJ are tested and set as bits. Plenty has no hexadecimal
# literals yet, so each line gives its values
# in hexadecimal in a trailing comment.

import tables

const DEFAULT: i64 = 0
const LINE_FEED: i64 = 1  # 0x0001
const EMOJI_MODIFIER: i64 = 2  # 0x0002
const REGIONAL_INDICATOR: i64 = 3  # 0x0003
const SEVERAL_REGIONAL_INDICATOR: i64 = 4  # 0x0004
const EMOJI_PRESENTATION: i64 = 5  # 0x0005
const ZWJ_EMOJI_PRESENTATION: i64 = 4102  # 0x1006
const VS16_ZWJ_EMOJI_PRESENTATION: i64 = 36870  # 0x9006
const KEYCAP_ZWJ_EMOJI_PRESENTATION: i64 = 4103  # 0x1007
const VS16_KEYCAP_ZWJ_EMOJI_PRESENTATION: i64 = 36871  # 0x9007
const REGIONAL_INDICATOR_ZWJ_PRESENTATION: i64 = 9  # 0x0009
const EVEN_REGIONAL_INDICATOR_ZWJ_PRESENTATION: i64 = 10  # 0x000A
const ODD_REGIONAL_INDICATOR_ZWJ_PRESENTATION: i64 = 11  # 0x000B
const TAG_END_ZWJ_EMOJI_PRESENTATION: i64 = 16  # 0x0010
const TAG_D1_END_ZWJ_EMOJI_PRESENTATION: i64 = 17  # 0x0011
const TAG_D2_END_ZWJ_EMOJI_PRESENTATION: i64 = 18  # 0x0012
const TAG_D3_END_ZWJ_EMOJI_PRESENTATION: i64 = 19  # 0x0013
const TAG_A1_END_ZWJ_EMOJI_PRESENTATION: i64 = 25  # 0x0019
const TAG_A2_END_ZWJ_EMOJI_PRESENTATION: i64 = 26  # 0x001A
const TAG_A3_END_ZWJ_EMOJI_PRESENTATION: i64 = 27  # 0x001B
const TAG_A4_END_ZWJ_EMOJI_PRESENTATION: i64 = 28  # 0x001C
const TAG_A5_END_ZWJ_EMOJI_PRESENTATION: i64 = 29  # 0x001D
const TAG_A6_END_ZWJ_EMOJI_PRESENTATION: i64 = 30  # 0x001E
const KIRAT_RAI_VOWEL_SIGN_E: i64 = 32  # 0x0020
const KIRAT_RAI_VOWEL_SIGN_AI: i64 = 33  # 0x0021
const VARIATION_SELECTOR_1_2_OR_3: i64 = 512  # 0x0200
const VARIATION_SELECTOR_15: i64 = 16384  # 0x4000
const VARIATION_SELECTOR_16: i64 = 32768  # 0x8000
const JOINING_GROUP_ALEF: i64 = 12543  # 0x30FF
const COMBINING_LONG_SOLIDUS_OVERLAY: i64 = 15615  # 0x3CFF
const SOLIDUS_OVERLAY_ALEF: i64 = 14591  # 0x38FF
const HEBREW_LETTER_LAMED: i64 = 14336  # 0x3800
const ZWJ_HEBREW_LETTER_LAMED: i64 = 15360  # 0x3C00
const BUGINESE_LETTER_YA: i64 = 14337  # 0x3801
const ZWJ_BUGINESE_LETTER_YA: i64 = 15361  # 0x3C01
const BUGINESE_VOWEL_SIGN_I_ZWJ_LETTER_YA: i64 = 15362  # 0x3C02
const TIFINAGH_CONSONANT: i64 = 14339  # 0x3803
const ZWJ_TIFINAGH_CONSONANT: i64 = 15363  # 0x3C03
const TIFINAGH_JOINER_CONSONANT: i64 = 15364  # 0x3C04
const LISU_TONE_LETTER_MYA_NA_JEU: i64 = 15365  # 0x3C05
const OLD_TURKIC_LETTER_ORKHON_I: i64 = 14342  # 0x3806
const ZWJ_OLD_TURKIC_LETTER_ORKHON_I: i64 = 15366  # 0x3C06
const KHMER_COENG_ELIGIBLE_LETTER: i64 = 15367  # 0x3C07

const LIGATURE_TRANSPARENT_MASK: i64 = 8192  # 0x2000
const LIGATURE_TRANSPARENT_BIT: i64 = 2048  # 0x0800
const ZWJ_BIT: i64 = 1024  # 0x0400

# A step result packs the width adjustment (-1 to 3) above the 16-bit state.
const ADD_BIAS: i64 = 4


def step(add: i64, state: i64) -> i64:
    ((add + ADD_BIAS) << 16) | state


def with_selector(state: i64, selector: i64) -> i64:
    if (state & LIGATURE_TRANSPARENT_MASK) != 0:
        return state | selector
    selector


def set_emoji_presentation(state: i64) -> i64:
    if (state & LIGATURE_TRANSPARENT_MASK) != 0 or (state & 36864) == 4096:  # 0x9000 0x1000
        return state | VARIATION_SELECTOR_16
    VARIATION_SELECTOR_16


def unset_emoji_presentation(state: i64) -> i64:
    if (state & LIGATURE_TRANSPARENT_MASK) != 0:
        return state & ~VARIATION_SELECTOR_16
    DEFAULT


def is_regional_indicator(c: i64) -> bool:
    c >= 127462 and c <= 127487  # 0x1F1E6 0x1F1FF


def is_tag_letter(c: i64) -> bool:
    c >= 917601 and c <= 917626  # 0xE0061 0xE007A


def is_tag_digit(c: i64) -> bool:
    c >= 917552 and c <= 917561  # 0xE0030 0xE0039


def is_tifinagh_consonant(c: i64) -> bool:
    (c >= 11569 and c <= 11621) or c == 11631  # 0x2D31 0x2D65 0x2D6F


# Sequences that start from an emoji presentation state or a ZWJ before one.
def emoji_step(c: i64, info: i64, kind: i64, wide: bool) -> i64:
    if (info == EMOJI_PRESENTATION or info == SEVERAL_REGIONAL_INDICATOR or info == EVEN_REGIONAL_INDICATOR_ZWJ_PRESENTATION or info == ODD_REGIONAL_INDICATOR_ZWJ_PRESENTATION or info == EMOJI_MODIFIER) and c == 8205:  # 0x200D
        return step(0, ZWJ_EMOJI_PRESENTATION)
    if info == ZWJ_EMOJI_PRESENTATION and c == 8419:  # 0x20E3
        return step(0, KEYCAP_ZWJ_EMOJI_PRESENTATION)
    if info == VS16_ZWJ_EMOJI_PRESENTATION and (tables.class_flags(kind) & tables.EMOJI_PRESENTATION_SEQ) != 0:
        return step(0, EMOJI_PRESENTATION)
    if info == VS16_KEYCAP_ZWJ_EMOJI_PRESENTATION and ((c >= 48 and c <= 57) or c == 35 or c == 42):  # 0x30 0x39 0x23 0x2A
        return step(0, EMOJI_PRESENTATION)
    if is_regional_indicator(c):
        if info == ZWJ_EMOJI_PRESENTATION:
            return step(1, REGIONAL_INDICATOR_ZWJ_PRESENTATION)
        if info == REGIONAL_INDICATOR_ZWJ_PRESENTATION or info == ODD_REGIONAL_INDICATOR_ZWJ_PRESENTATION:
            return step(-1, EVEN_REGIONAL_INDICATOR_ZWJ_PRESENTATION)
        if info == EVEN_REGIONAL_INDICATOR_ZWJ_PRESENTATION:
            return step(3, ODD_REGIONAL_INDICATOR_ZWJ_PRESENTATION)
    if info == ZWJ_EMOJI_PRESENTATION and c >= 127995 and c <= 127999:  # 0x1F3FB 0x1F3FF
        return step(0, EMOJI_MODIFIER)
    if info == ZWJ_EMOJI_PRESENTATION and c == 917631:  # 0xE007F
        return step(0, TAG_END_ZWJ_EMOJI_PRESENTATION)
    if is_tag_letter(c):
        if info == TAG_END_ZWJ_EMOJI_PRESENTATION:
            return step(0, TAG_A1_END_ZWJ_EMOJI_PRESENTATION)
        if info >= TAG_A1_END_ZWJ_EMOJI_PRESENTATION and info <= TAG_A5_END_ZWJ_EMOJI_PRESENTATION:
            return step(0, info + 1)
    if is_tag_digit(c):
        if info == TAG_END_ZWJ_EMOJI_PRESENTATION or (info >= TAG_A1_END_ZWJ_EMOJI_PRESENTATION and info <= TAG_A4_END_ZWJ_EMOJI_PRESENTATION):
            return step(0, TAG_D1_END_ZWJ_EMOJI_PRESENTATION)
        if info == TAG_D1_END_ZWJ_EMOJI_PRESENTATION or info == TAG_D2_END_ZWJ_EMOJI_PRESENTATION:
            return step(0, info + 1)
    if c == 127988:  # 0x1F3F4
        if info == TAG_D3_END_ZWJ_EMOJI_PRESENTATION or (info >= TAG_A3_END_ZWJ_EMOJI_PRESENTATION and info <= TAG_A6_END_ZWJ_EMOJI_PRESENTATION):
            return step(0, EMOJI_PRESENTATION)
    if info == ZWJ_EMOJI_PRESENTATION and tables.class_state(kind, wide) == EMOJI_PRESENTATION:
        return step(0, EMOJI_PRESENTATION)
    -1


# Ligatures and scripts with contextual width.
def script_step(c: i64, info: i64, kind: i64, wide: bool) -> i64:
    flags = tables.class_flags(kind)
    if wide and info == COMBINING_LONG_SOLIDUS_OVERLAY and (flags & tables.SOLIDUS_TRANSPARENT) != 0:
        return step(tables.class_width(kind, True), COMBINING_LONG_SOLIDUS_OVERLAY)
    if wide and info == JOINING_GROUP_ALEF and c == 824:  # 0x0338
        return step(0, SOLIDUS_OVERLAY_ALEF)
    if info == JOINING_GROUP_ALEF or (wide and info == SOLIDUS_OVERLAY_ALEF):
        if (flags & tables.JOINING_GROUP_LAM) != 0:
            return step(0, DEFAULT)
        if (flags & tables.TRANSPARENT_ZERO_WIDTH) != 0:
            return step(0, JOINING_GROUP_ALEF)
    if info == ZWJ_HEBREW_LETTER_LAMED and c == 1488:  # 0x05D0
        return step(0, DEFAULT)
    if info == KHMER_COENG_ELIGIBLE_LETTER and c == 6098:  # 0x17D2
        return step(-1, DEFAULT)
    if info == ZWJ_BUGINESE_LETTER_YA and c == 6679:  # 0x1A17
        return step(0, BUGINESE_VOWEL_SIGN_I_ZWJ_LETTER_YA)
    if info == BUGINESE_VOWEL_SIGN_I_ZWJ_LETTER_YA and c == 6677:  # 0x1A15
        return step(0, DEFAULT)
    if (info == TIFINAGH_CONSONANT or info == ZWJ_TIFINAGH_CONSONANT) and c == 11647:  # 0x2D7F
        return step(1, TIFINAGH_JOINER_CONSONANT)
    if info == ZWJ_TIFINAGH_CONSONANT and is_tifinagh_consonant(c):
        return step(0, DEFAULT)
    if info == TIFINAGH_JOINER_CONSONANT and is_tifinagh_consonant(c):
        return step(-1, DEFAULT)
    if info == LISU_TONE_LETTER_MYA_NA_JEU and c >= 42232 and c <= 42235:  # 0xA4F8 0xA4FB
        return step(0, DEFAULT)
    if info == ZWJ_OLD_TURKIC_LETTER_ORKHON_I and c == 68658:  # 0x10C32
        return step(0, DEFAULT)
    if info == EMOJI_MODIFIER and (flags & tables.EMOJI_MODIFIER_BASE) != 0:
        return step(0, EMOJI_PRESENTATION)
    if (info == REGIONAL_INDICATOR or info == SEVERAL_REGIONAL_INDICATOR) and is_regional_indicator(c):
        return step(1, SEVERAL_REGIONAL_INDICATOR)
    if info == KIRAT_RAI_VOWEL_SIGN_E:
        if c == 93539 or c == 93545:  # 0x16D63 0x16D69
            return step(0, DEFAULT)
        if c == 93543:  # 0x16D67
            return step(0, KIRAT_RAI_VOWEL_SIGN_AI)
        if c == 93544:  # 0x16D68
            return step(1, KIRAT_RAI_VOWEL_SIGN_E)
    if info == KIRAT_RAI_VOWEL_SIGN_AI and c == 93539:  # 0x16D63
        return step(0, DEFAULT)
    -1


# unicode-width's `width_in_str` (and `width_in_str_cjk` when `wide`).
def scalar_in_text(c: i64, next_info: i64, wide: bool) -> i64:
    kind = tables.width_class(c)
    mut info = next_info
    if (info & VARIATION_SELECTOR_16) != 0:
        if (tables.class_flags(kind) & tables.EMOJI_PRESENTATION_SEQ) != 0:
            return step(0 if (info & 45056) == 36864 else 2, EMOJI_PRESENTATION)  # 0xB000 0x9000
        info = unset_emoji_presentation(info)
    if wide and (info == COMBINING_LONG_SOLIDUS_OVERLAY or info == SOLIDUS_OVERLAY_ALEF):
        if c == 60 or c == 61 or c == 62:  # 0x3C 0x3D 0x3E
            return step(2, DEFAULT)
    if c <= 160:  # 0xA0
        if c == 10:  # 0x0A
            return step(1, LINE_FEED)
        if c == 13 and info == LINE_FEED:  # 0x0D
            return step(0, DEFAULT)
        return step(1, DEFAULT)
    if info != DEFAULT:
        if c == 65039:  # 0xFE0F
            return step(0, set_emoji_presentation(info))
        if (wide and (c == 65024 or c == 65026)) or (not wide and c == 65025):  # 0xFE00 0xFE02 0xFE01
            return step(0, with_selector(info, VARIATION_SELECTOR_1_2_OR_3))
        if not wide and c == 65038:  # 0xFE0E
            return step(0, with_selector(info, VARIATION_SELECTOR_15))
        if not wide and (info & VARIATION_SELECTOR_15) != 0:
            if (tables.class_flags(kind) & tables.TEXT_PRESENTATION_SEQ) != 0:
                return step(1, DEFAULT)
            info = info & ~VARIATION_SELECTOR_15
        elif (info & VARIATION_SELECTOR_1_2_OR_3) != 0:
            if c == 8216 or c == 8217 or c == 8220 or c == 8221:  # 0x2018 0x2019 0x201C 0x201D
                return step(1 if wide else 2, DEFAULT)
            info = info & ~VARIATION_SELECTOR_1_2_OR_3
        if (info & LIGATURE_TRANSPARENT_BIT) != 0:
            if c == 8205:  # 0x200D
                return step(0, info | ZWJ_BIT)
            if (tables.class_flags(kind) & tables.LIGATURE_TRANSPARENT) != 0:
                return step(0, info)
        scripted = script_step(c, info, kind, wide)
        if scripted >= 0:
            return scripted
        emoji = emoji_step(c, info, kind, wide)
        if emoji >= 0:
            return emoji
    step(tables.class_width(kind, wide), tables.class_state(kind, wide))


pub def text_width(text: &str, wide: bool) -> i64:
    mut total = 0
    mut info = DEFAULT
    for scalar in reversed(*text):
        mut c = 0
        match ord(scalar):
            case Ok(value):
                c = i64(value)
            case Err(_):
                pass
        packed = scalar_in_text(c, info, wide)
        total += (packed >> 16) - ADD_BIAS
        info = packed & 65535  # 0xFFFF
    total


pub def scalar_width(c: i64, wide: bool) -> Option[i64]:
    if c < 32 or (c >= 127 and c < 160):  # 0x20 0x7F 0xA0
        return Nothing
    Some(tables.class_width(tables.width_class(c), wide))
